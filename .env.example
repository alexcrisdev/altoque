# URL base que va dentro de los QR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (las claves se piden al equipo por privado)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: nunca usarla en código del navegador
SUPABASE_SERVICE_ROLE_KEY=
DEMO_PASSWORD=

# US-076: Stripe en modo prueba (sandbox). Solo servidor, nunca NEXT_PUBLIC_.
# La secreta sale de Desarrolladores -> Claves de API (sk_test_...).
# El whsec_ en local sale de `stripe listen --print-secret`; en Vercel, del
# endpoint de webhook creado en el dashboard de Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# US-086: aviso a n8n cuando un pago queda confirmado. Si están vacías, no se
# avisa y el cobro funciona igual. URL completa del webhook de producción de n8n
# (https://<tunel>/webhook/altoque-pago-confirmado). El secreto (32+ caracteres)
# es el mismo que se escribe en el nodo "Secreto compartido" del flujo.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# US-040: opcionales si los QR del seed fueron reemplazados. Solo el token,
# sin /m/. No subir valores reales. Mesa 2 está excluida de las pruebas E2E.
E2E_BASE_URL=
E2E_MESA_NUMERO=5
E2E_MESA_TOKEN=
E2E_MOSTRADOR_TOKEN=
