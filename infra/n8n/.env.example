# Copiar a .env en esta carpeta. No reutilizar secretos de AlToque/Supabase.
# Generar una clave aleatoria de 32 bytes; mantenerla junto a la copia del volumen.
N8N_ENCRYPTION_KEY=

# Al iniciar, usar localhost. Sustituir por la URL HTTPS REAL que dé Cloudflare.
# Conservar la barra final. Cambiarla requiere recrear n8n, no borrar el volumen.
N8N_WEBHOOK_URL=http://localhost:5678/

# Gmail OAuth y Header Auth se configuran en Credentials del editor local.
# No guardar contraseñas, client secrets ni tokens dentro de workflows exportados.
